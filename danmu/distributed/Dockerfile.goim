# 一次编译出 goim 全链路的所有二进制；各 compose 服务用 command 选择运行哪个。
# 前端先由 node 阶段构建，dist 供 ops 的 go:embed 内嵌。
FROM node:20-alpine AS web
WORKDIR /web
COPY ops/web/package.json ops/web/package-lock.json ./
RUN npm ci
COPY ops/web/ ./
RUN npm run build

FROM golang:1.25-alpine AS build
WORKDIR /src
# 先拷模块文件以利用缓存
COPY go.mod go.sum ./
RUN go mod download || true
COPY . .
COPY --from=web /web/dist ops/web/dist
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/logic    ./logic/ \
 && CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/job      ./job/ \
 && CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/comet    ./comet/ \
 && CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/ops      ./cmd/ops/
# 注：Kafka→ClickHouse 落库的 consumer 属架构无关的公共组件，仍在 ../monolith，
# 由 docker-compose.goim.yml 里的 consumer 服务用 ../monolith 作为 build context 单独构建。

FROM alpine:3.20
WORKDIR /app
COPY --from=build /out/ /app/
COPY web/ /app/web/
