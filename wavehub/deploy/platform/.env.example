# X-Plore 平台环境变量样例（复制为 .env 后填写，勿提交真实密钥）
# APP_ENV=dev|prod

APP_ENV=dev
JWT_SECRET=change-me-in-production-use-long-random
DANMU_AUTH_TOKEN=change-me-loadtest-only

# --- 数据 ---
PG_DSN=host=localhost user=wavehub password=wavehub dbname=wavehub port=5432 sslmode=disable
REDIS_ADDR=localhost:6379

# --- MinIO / S3 ---
MINIO_ADDR=localhost:9000
MINIO_ACCESS_KEY=wavehub
MINIO_SECRET_KEY=wavehub123
MINIO_BUCKET=xplore-video
MINIO_PUBLIC_BASE=http://localhost:9000/xplore-video

# --- 服务地址 ---
USER_GRPC_ADDR=localhost:9001
VIDEO_GRPC_ADDR=localhost:9003
HTTP_ADDR=:8003
# user service:
# HTTP_ADDR=:8001 GRPC_ADDR=:9001

# --- 弹幕 ---
DANMU_WS_URL=ws://localhost:8080/ws
# 生产：限制浏览器 Origin
WS_ALLOWED_ORIGINS=https://your.domain,http://localhost:5173

# --- Gateway ---
# HTTP_ADDR=:8088
USER_HTTP=http://127.0.0.1:8001
VIDEO_HTTP=http://127.0.0.1:8003
COMET_HTTP=http://127.0.0.1:8080
# 生产务必设置白名单（逗号分隔）；开发可留空
CORS_ORIGINS=http://localhost:5173,https://your.domain
RATE_LIMIT_PER_SEC=100

# --- media worker ---
ENABLE_TRACK_WORKER=false
MINIO_VIDEO_BUCKET=xplore-video

# --- 前端 (web-app) ---
# VITE_API_BASE=https://api.your.domain
# VITE_DANMU_WS=wss://api.your.domain/ws
